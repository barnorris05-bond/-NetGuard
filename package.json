{
  "name": "netguard",
  "version": "1.0.0",
  "private": true,
  "description": "NetGuard – Graph-Based Network Reliability Simulator",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm run dev -w server",
    "dev:client": "npm run dev -w client",
    "build": "npm run build -w server && npm run build -w client",
    "test": "npm test -w server",
    "typecheck": "npm run typecheck -w server && npm run typecheck -w client",
    "start": "npm run start -w server"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
